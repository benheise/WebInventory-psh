{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:webinventory.vuln/1",
  "x-tideline-schema": "webinventory.vuln/1",
  "title": "WebInventory vulnerability line",
  "description": "One line of WebInventory_<RunId>_vulns.jsonl (-NvdFeed on a scan run) or of a -StoreQuery Vulnerabilities JSONL: one service and CVE, matched offline from the service's CPE and version, with CISA KEV and FIRST EPSS when given. Values are the CSV's cells as text (without the CSV's formula guard); counts, ports, sizes and durations are integers when the cell holds one, \"\" when it is empty.",
  "type": "object",
  "required": [
    "Host",
    "IP",
    "Port",
    "Url",
    "Cpe",
    "Cve"
  ],
  "properties": {
    "Host": {
      "type": "string"
    },
    "IP": {
      "type": "string"
    },
    "Port": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Url": {
      "type": "string"
    },
    "Status": {
      "type": "string"
    },
    "Products": {
      "type": "string"
    },
    "Cpe": {
      "type": "string"
    },
    "Cve": {
      "type": "string"
    },
    "Kev": {
      "type": "string"
    },
    "KevDateAdded": {
      "type": "string"
    },
    "KevDueDate": {
      "type": "string"
    },
    "KevRansomware": {
      "type": "string"
    },
    "Epss": {
      "type": "string"
    },
    "EpssPercentile": {
      "type": "string"
    },
    "CvssScore": {
      "type": "string"
    },
    "CvssSeverity": {
      "type": "string"
    },
    "CvssVersion": {
      "type": "string"
    },
    "Published": {
      "type": "string"
    },
    "Match": {
      "type": "string"
    },
    "EntityId": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
