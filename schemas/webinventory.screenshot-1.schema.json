{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:webinventory.screenshot/1",
  "x-tideline-schema": "webinventory.screenshot/1",
  "title": "WebInventory screenshot index line",
  "description": "One line of WebInventory_<RunId>_screenshots.jsonl: a capture and its check (Status ok, blank, suspect or failed, with Reason). File is the PNG's path relative to the output folder, empty when no image was taken. Values are the CSV's cells as text (without the CSV's formula guard); counts, ports, sizes and durations are integers when the cell holds one, \"\" when it is empty.",
  "type": "object",
  "required": [
    "Url",
    "Host",
    "IP",
    "Port",
    "File",
    "Sha256",
    "Status"
  ],
  "properties": {
    "Url": {
      "type": "string"
    },
    "Host": {
      "type": "string"
    },
    "IP": {
      "type": "string"
    },
    "Port": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "File": {
      "type": "string"
    },
    "Sha256": {
      "type": "string"
    },
    "Bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Status": {
      "enum": [
        "ok",
        "blank",
        "suspect",
        "failed"
      ]
    },
    "Reason": {
      "type": "string"
    },
    "PageTitle": {
      "type": "string"
    },
    "PageRequests": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "BlockedOrigins": {
      "type": "string"
    },
    "ProxyRefused": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "BrowserUrl": {
      "type": "string"
    },
    "BrowserStatus": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Capture": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
