{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:tideline-envelope/1",
  "title": "Tideline run envelope",
  "description": "The signed manifest a sensor sends with POST /v1/runs. The signature (ES256) covers these exact bytes and travels in the Tideline-Signature header. Each part's sha256 and bytes are taken over the bytes the part carries as the tool wrote them, before any gzip, and match the tool's own SHA-256 manifest; a file split into chunks also carries the whole file's file_sha256 and file_bytes. Minor 1 adds the optional part fields encoding, role, chunk, chunks, file_bytes and file_sha256, media parameters, and name-based (version 5) run ids, all written by WebInventory 2.6.",
  "x-tideline-schema": "tideline-envelope/1",
  "x-minor": 1,
  "type": "object",
  "properties": {
    "schema": {
      "const": "tideline-envelope/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID: version 4, or version 5 (name-based) for a run WebInventory made before 2.6"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sensor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "engagement": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "started": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "finished": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "profile": {
      "type": "object"
    },
    "tool_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,31}$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*/[0-9]+$"
          },
          "media": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z]+/[a-z0-9.+-]+(; ?[a-z0-9-]+=[A-Za-z0-9._-]+)*$",
            "description": "a media type, with optional parameters (text/plain; charset=utf-8)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "encoding": {
            "enum": [
              "gzip",
              "identity"
            ],
            "description": "Content-Encoding of the upload; absent means gzip"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "what an artifact is: run-info, tool-manifest, vuln-provenance, log, screenshot"
          },
          "chunk": {
            "type": "integer",
            "minimum": 1,
            "description": "this part's position when one file is sent as several parts"
          },
          "chunks": {
            "type": "integer",
            "minimum": 2,
            "description": "how many parts the file was split into"
          },
          "file_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "size of the whole file a chunk belongs to"
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the whole file a chunk belongs to"
          }
        },
        "required": [
          "n",
          "kind",
          "name",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "artifact"
                }
              }
            },
            "then": {
              "required": [
                "media"
              ]
            },
            "else": {
              "required": [
                "schema",
                "records"
              ]
            }
          },
          {
            "if": {
              "required": [
                "chunk"
              ]
            },
            "then": {
              "required": [
                "chunks",
                "file_bytes",
                "file_sha256"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "tool",
    "tool_version",
    "sensor",
    "engagement",
    "job_id",
    "started",
    "finished",
    "exit_code",
    "profile",
    "tool_manifest_sha256",
    "parts"
  ],
  "additionalProperties": false
}
