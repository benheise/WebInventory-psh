{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:tideline-envelope/1",
  "x-tideline-schema": "tideline-envelope/1",
  "title": "Tideline run envelope (manifest)",
  "description": "The manifest a sensor sends with POST /v1/runs, signed (ES256) over its exact bytes in the Tideline-Signature header. Each part is then uploaded with PUT /v1/runs/{run_id}/parts/{n}. See SHIPPING.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "tool",
    "tool_version",
    "sensor",
    "engagement",
    "job_id",
    "started",
    "finished",
    "exit_code",
    "profile",
    "tool_manifest_sha256",
    "parts"
  ],
  "properties": {
    "schema": {
      "const": "tideline-envelope/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "tool_version": {
      "type": "string",
      "maxLength": 40
    },
    "sensor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "must equal the sensor id in the client certificate"
    },
    "engagement": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "started": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "finished": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ],
      "description": "the scan's exit code (store and shipping stages not included); null for runs made before 2.6"
    },
    "profile": {
      "type": "object",
      "description": "the run.json profile, unchanged"
    },
    "tool_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "kind",
          "media",
          "name",
          "bytes",
          "sha256",
          "encoding"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "a record kind (NDJSON) or artifact"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*/[0-9]+$",
            "description": "record schema of an NDJSON part"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "what an artifact is: run-info, tool-manifest, vuln-provenance, log, screenshot"
          },
          "media": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "the file's path in the run folder (forward slashes)"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "size before compression"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the part before compression (for a whole file: as in the tool's own manifest)"
          },
          "encoding": {
            "enum": [
              "gzip",
              "identity"
            ],
            "description": "Content-Encoding of the upload"
          },
          "chunk": {
            "type": "integer",
            "minimum": 1
          },
          "chunks": {
            "type": "integer",
            "minimum": 2
          },
          "file_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "artifact"
                }
              }
            },
            "then": {
              "required": [
                "role"
              ]
            },
            "else": {
              "required": [
                "schema",
                "records"
              ]
            }
          },
          {
            "if": {
              "required": [
                "chunk"
              ]
            },
            "then": {
              "required": [
                "chunks",
                "file_bytes",
                "file_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}
