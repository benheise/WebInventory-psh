{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:webinventory.vuln/1",
  "title": "WebInventory vulnerability match",
  "description": "Frozen in schemas-v1.1.0 from what WebInventory 2.6 writes (it replaces the draft of v1.0.0, which typed every value as a string). One line of WebInventory_<RunId>_vulns.jsonl (-NvdFeed on a scan run) or of a -StoreQuery Vulnerabilities JSONL: one service and CVE, matched offline from the service's CPE and version, with CISA KEV and FIRST EPSS when given. Values are the CSV's cells as text (without the CSV's formula guard); counts, ports, sizes and durations are integers when the cell holds one, \"\" when it is empty.",
  "x-tideline-schema": "webinventory.vuln/1",
  "x-minor": 0,
  "x-producer": "WebInventory 2.6 and later (-NvdFeed on a scan run)",
  "type": "object",
  "properties": {
    "Host": {
      "type": "string"
    },
    "IP": {
      "type": "string"
    },
    "Port": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Url": {
      "type": "string"
    },
    "Status": {
      "type": "string"
    },
    "Products": {
      "type": "string"
    },
    "Cpe": {
      "type": "string"
    },
    "Cve": {
      "type": "string"
    },
    "Kev": {
      "type": "string"
    },
    "KevDateAdded": {
      "type": "string"
    },
    "KevDueDate": {
      "type": "string"
    },
    "KevRansomware": {
      "type": "string"
    },
    "Epss": {
      "type": "string"
    },
    "EpssPercentile": {
      "type": "string"
    },
    "CvssScore": {
      "type": "string"
    },
    "CvssSeverity": {
      "type": "string"
    },
    "CvssVersion": {
      "type": "string"
    },
    "Published": {
      "type": "string"
    },
    "Match": {
      "type": "string"
    },
    "EntityId": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    }
  },
  "required": [
    "Host",
    "IP",
    "Port",
    "Url",
    "Status",
    "Products",
    "Cpe",
    "Cve",
    "Kev",
    "KevDateAdded",
    "KevDueDate",
    "KevRansomware",
    "Epss",
    "EpssPercentile",
    "CvssScore",
    "CvssSeverity",
    "CvssVersion",
    "Published",
    "Match",
    "EntityId",
    "Description"
  ],
  "additionalProperties": true
}
