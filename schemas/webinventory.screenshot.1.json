{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:webinventory.screenshot/1",
  "title": "WebInventory screenshot",
  "description": "Frozen in schemas-v1.1.0 from what WebInventory 2.6 writes (it replaces the draft of v1.0.0, which typed every value as a string). One line of WebInventory_<RunId>_screenshots.jsonl: a capture and its check (Status ok, blank, suspect or failed, with Reason). File is the PNG's path relative to the output folder, empty when no image was taken. Values are the CSV's cells as text (without the CSV's formula guard); counts, ports, sizes and durations are integers when the cell holds one, \"\" when it is empty.",
  "x-tideline-schema": "webinventory.screenshot/1",
  "x-minor": 0,
  "x-producer": "WebInventory 2.6 and later",
  "type": "object",
  "properties": {
    "Url": {
      "type": "string"
    },
    "Host": {
      "type": "string"
    },
    "IP": {
      "type": "string"
    },
    "Port": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "File": {
      "type": "string"
    },
    "Sha256": {
      "type": "string"
    },
    "Bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Status": {
      "enum": [
        "ok",
        "blank",
        "suspect",
        "failed"
      ]
    },
    "Reason": {
      "type": "string"
    },
    "PageTitle": {
      "type": "string"
    },
    "PageRequests": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "BlockedOrigins": {
      "type": "string"
    },
    "ProxyRefused": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "BrowserUrl": {
      "type": "string"
    },
    "BrowserStatus": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": ""
        }
      ]
    },
    "Capture": {
      "type": "string"
    }
  },
  "required": [
    "Url",
    "Host",
    "IP",
    "Port",
    "File",
    "Sha256",
    "Bytes",
    "Status",
    "Reason",
    "PageTitle",
    "PageRequests",
    "BlockedOrigins",
    "ProxyRefused",
    "Ms",
    "BrowserUrl",
    "BrowserStatus",
    "Capture"
  ],
  "additionalProperties": true
}
