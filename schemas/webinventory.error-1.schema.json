{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tideline:schema:webinventory.error/1",
  "x-tideline-schema": "webinventory.error/1",
  "title": "WebInventory error or warning",
  "description": "One line of WebInventory_<RunId>_errors.jsonl: what the run's error log holds (level error or fatal, with the category and the target) and the run log's warnings (level warning).",
  "type": "object",
  "required": [
    "time",
    "level",
    "category",
    "target",
    "message"
  ],
  "properties": {
    "time": {
      "type": "string"
    },
    "level": {
      "enum": [
        "error",
        "warning",
        "fatal"
      ]
    },
    "category": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
